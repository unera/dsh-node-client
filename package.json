{
  "name": "@dr-co/dsh-node-client",
  "version": "0.0.91",
  "description": "Client for dsh-nodes: runs on a remote machine, declares its APIs and executes commands from a DSH session",
  "type": "module",
  "bin": {
    "dshnc": "./bin/dshnc.mjs"
  },
  "exports": {
    ".": "./lib/runner.mjs",
    "./api": "./lib/api.mjs",
    "./bash": "./lib/bash.mjs",
    "./config": "./lib/config.mjs"
  },
  "files": [
    "bin/",
    "lib/",
    "README.md"
  ],
  "scripts": {
    "test": "node --test --test-concurrency=1 test/*.test.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "remote",
    "node",
    "client"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unera/dsh-node-client.git"
  },
  "dependencies": {
    "yaml": "^2.9.1",
    "ws": "^8.18.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
